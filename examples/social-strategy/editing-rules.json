  "examples": [
    {
      "input": "冷蔵庫を何度も開けているけど、食べ物が増えるわけではない。",
      "operation": "remove_redundancy",
      "output": "冷蔵庫を何度開けても食べ物は増えない。"
    },
    {
      "input": "冷蔵庫を何度開けても食べ物は増えない。",
      "operation": "introduce_metaphor",
      "output": "冷蔵庫をリロードしても在庫は増えない。"
    },
    {
      "input": "冷蔵庫をリロードしても在庫は増えない。",
      "operation": "add_punchline",
      "output": "冷蔵庫をリロードしても在庫は増えない。不具合だろ。"
    }
  ]
