      "feature": "original_wordplay",
      "condition": "humor",
      "operation": "preserve_wordplay",
      "criterion": "originality",
      "status": "hypothesis"
    },
    {
      "id": "R4",
      "feature": "long_setup",
      "condition": "humor",
      "operation": "shorten_setup",
      "criterion": "rhythm",
      "status": "hypothesis"
    },
    {
